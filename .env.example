DISCORD_TOKEN=your_discord_bot_token_here
DATABASE_PATH=data.sqlite3
CARMEET_REVIEW_CHANNEL_ID=0
CARMEET_STAFF_ROLE_ID=0
CARMEET_ACCEPTED_ROLE_ID=0
LOG_CHANNEL_ID=0
# Replace with Dino's real numeric user ID(s), comma-separated; leave blank to disable.
TRUSTED_ROLE_MANAGEMENT_BOT_IDS=
# Must point to a running Lavalink v4 node. For local development: http://127.0.0.1:2333
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=
# Set after authorizing a burner Google account; keep the token secret.
YOUTUBE_OAUTH_REFRESH_TOKEN=
# scsearch (SoundCloud) works on datacenter IPs (Railway, etc.).
# Use ytmsearch only after the Lavalink node completed the YouTube OAuth sign-in.
MUSIC_SEARCH_SOURCE=scsearch
PREMIUM_NICKNAME_BASE=KYRO
PREMIUM_TICK_EMOJI=✅
# Optional roles exempt from mass-mention warnings, comma-separated.
MASS_MENTION_WHITELIST_ROLE_IDS=
MASS_MENTION_DECAY_HOURS=24
LIVE_ANIMATION=false
LINK_FILTER_WHITELIST_ROLE_IDS=
LINK_FILTER_WHITELIST_CHANNEL_IDS=
LINK_FILTER_WHITELIST_DOMAINS=
LINK_FILTER_DELETE_DELAY=8
LINK_FILTER_LOG_CHANNEL_ID=0
PROMO_IMAGE_WARNING_DELETE_DELAY=8
# Global protected owner Discord IDs (comma-separated). These users are never auto-punished by any protection.
GLOBAL_PROTECTED_OWNER_IDS=
OWNER_HUB_GUILD_ID=0
OWNER_HUB_LOG_CHANNEL_ID=0
OWNER_HUB_DASHBOARD_CHANNEL_ID=0
# Dashboard OAuth values. The redirect URI is derived from the frontend origin:
# https://your-website.example/api/auth/callback
DASHBOARD_DISCORD_CLIENT_ID=
DASHBOARD_DISCORD_CLIENT_SECRET=
DASHBOARD_FRONTEND_URL=https://your-website.example
